{
  "id": "bold-band",
  "name": "Modern Minimal Badge",
  "designType": "idCard",
  "description": "Clean dual-tone vertical badge with circular ring portrait, lanyard badge slot, and balanced typography.",
  "version": 5,
  "size": {
    "name": "CR80 (Standard ID 54x86mm)",
    "widthMm": 54,
    "heightMm": 85.6,
    "bleedMm": 3,
    "safeMarginMm": 3
  },
  "orientation": "portrait",
  "hasFrontBack": true,
  "tags": ["minimal", "dual-tone", "vertical-split", "lanyard-badge", "clean"],
  "supportedRoles": ["participant", "organizer", "mentor", "volunteer", "judge", "speaker"],
  "elements": [
    {
      "type": "shape",
      "id": "header-bg",
      "anchor": { "x": 0, "y": 0, "w": 54, "h": 38 },
      "shape": "rect",
      "fill": "#ffffff",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1,
      "roleConditional": {
        "organizer": { "fill": "#FAF8F4" },
        "judge": { "fill": "#FAF8F4" }
      }
    },
    {
      "type": "shape",
      "id": "lanyard-slot",
      "anchor": { "x": 22, "y": 2.2, "w": 10, "h": 2.6 },
      "shape": "rect",
      "fill": "#E9E5D8",
      "stroke": "#D9D5C7",
      "strokeWidth": 0.35,
      "cornerRadius": 1.3,
      "opacity": 1
    },
    {
      "type": "image",
      "id": "acm-logo",
      "anchor": { "x": 3.5, "y": 6.5, "w": 9, "h": 9 },
      "src": "/assets/acm-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "image",
      "id": "svnit-logo",
      "anchor": { "x": 41.5, "y": 6.5, "w": 9, "h": 9 },
      "src": "/assets/svnit-logo.svg",
      "fit": "contain",
      "cornerRadius": 4.5,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "text",
      "id": "badge-type-label",
      "anchor": { "x": 13, "y": 6.8, "w": 28, "h": 3.2 },
      "content": "IDENTIFICATION BADGE",
      "fontFamily": "Hanken Grotesk",
      "fontSize": 2.7,
      "fontWeight": "700",
      "color": "#66706A",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2,
      "roleConditional": {
        "organizer": { "color": "#0F5C4D", "content": "OFFICIAL COMMITTEE PASS" },
        "judge":     { "color": "#3B4842", "content": "HONORARY JURY BADGE" },
        "speaker":   { "color": "#7B3833", "content": "KEYNOTE SPEAKER PASS" },
        "volunteer": { "color": "#2E5A44", "content": "EVENT CREW PASS" },
        "mentor":    { "color": "#8B5E3C", "content": "MENTOR AND ADVISOR" }
      }
    },
    {
      "type": "text",
      "id": "event-name-header",
      "anchor": { "x": 11, "y": 9.0, "w": 32, "h": 6.5 },
      "content": "{{event.name.value}}",
      "fontFamily": "Instrument Serif",
      "fontSize": 6.5,
      "fontWeight": "400",
      "color": "#14201C",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 4.5
    },
    {
      "type": "text",
      "id": "badge-serial",
      "anchor": { "x": 13, "y": 15.5, "w": 28, "h": 3 },
      "content": "No. {{person.id}}",
      "fontFamily": "Hanken Grotesk",
      "fontSize": 2.7,
      "fontWeight": "500",
      "color": "#66706A",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2
    },
    {
      "type": "shape",
      "id": "lower-bg",
      "anchor": { "x": 0, "y": 38, "w": 54, "h": 47.6 },
      "shape": "rect",
      "fill": "#14201C",
      "fillBinding": "{{role.palette.secondary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "split-slash-left",
      "anchor": { "x": 3, "y": 36.5, "w": 10, "h": 3 },
      "shape": "polygon",
      "points": "0,0 8,0 6,3 0,3",
      "fill": "#0F5C4D",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 0.95
    },
    {
      "type": "shape",
      "id": "split-slash-right",
      "anchor": { "x": 41, "y": 36.5, "w": 10, "h": 3 },
      "shape": "polygon",
      "points": "2,0 10,0 10,3 4,3",
      "fill": "#0F5C4D",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 0.95
    },
    {
      "type": "shape",
      "id": "bg-wireframe",
      "anchor": { "x": 0, "y": 64, "w": 54, "h": 21 },
      "shape": "polygon",
      "points": "0,21 12,0 24,21 36,0 48,21 54,10",
      "fill": "transparent",
      "stroke": "#D9D5C7",
      "strokeWidth": 0.35,
      "cornerRadius": 0,
      "opacity": 0.15
    },
    {
      "type": "shape",
      "id": "photo-ring",
      "anchor": { "x": 15, "y": 25, "w": 24, "h": 24 },
      "shape": "circle",
      "fill": "transparent",
      "stroke": "#D9D5C7",
      "strokeWidth": 1.2,
      "cornerRadius": 12,
      "opacity": 1,
      "roleConditional": {
        "organizer": { "stroke": "#0F5C4D" },
        "judge":     { "stroke": "#C4BFAE" },
        "speaker":   { "stroke": "#E9E5D8" }
      }
    },
    {
      "type": "photo",
      "id": "person-photo",
      "anchor": { "x": 16.2, "y": 26.2, "w": 21.6, "h": 21.6 },
      "binding": "{{person.photoUrl}}",
      "shape": "circle",
      "cornerRadius": 10.8,
      "fallback": "initials",
      "initialsBinding": "{{person.name}}",
      "initialsColor": "#ffffff",
      "initialsBg": "{{role.palette.primary}}"
    },
    {
      "type": "text",
      "id": "person-name",
      "anchor": { "x": 2, "y": 52, "w": 50, "h": 7.8 },
      "content": "{{person.name}}",
      "fontFamily": "Instrument Serif",
      "fontSize": 9.0,
      "fontWeight": "400",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 2,
      "minFontSize": 6.0
    },
    {
      "type": "shape",
      "id": "role-pill-bg",
      "anchor": { "x": 13, "y": 60.5, "w": 28, "h": 5.5 },
      "shape": "rect",
      "cornerRadius": 2.75,
      "fill": "#0F5C4D",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "opacity": 1,
      "roleConditional": {
        "organizer": { "stroke": "#D9D5C7" },
        "judge":     { "stroke": "#C4BFAE" }
      }
    },
    {
      "type": "text",
      "id": "role-label",
      "anchor": { "x": 13, "y": 60.5, "w": 28, "h": 5.5 },
      "content": "{{role.label}}",
      "fontFamily": "Hanken Grotesk",
      "fontSize": 4.2,
      "fontWeight": "600",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.2
    },
    {
      "type": "text",
      "id": "person-detail",
      "anchor": { "x": 2, "y": 67.2, "w": 50, "h": 4 },
      "content": "{{person.team}}",
      "fontFamily": "Hanken Grotesk",
      "fontSize": 3.6,
      "fontWeight": "500",
      "color": "#D9D5C7",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2.8
    },
    {
      "type": "text",
      "id": "event-venue-date",
      "anchor": { "x": 2, "y": 71.6, "w": 50, "h": 3.5 },
      "content": "{{event.venue.value}} - {{event.dateStart.value}}",
      "fontFamily": "Hanken Grotesk",
      "fontSize": 3.1,
      "fontWeight": "400",
      "color": "#C4BFAE",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2.5
    },
    {
      "type": "qr",
      "id": "person-qr",
      "anchor": { "x": 23, "y": 75.6, "w": 8, "h": 8 },
      "urlPattern": "https://acm.svnit.ac.in/verify/{{person.id}}",
      "fgColor": "#ffffff",
      "bgColor": "transparent",
      "errorCorrection": "M"
    },
    {
      "type": "text",
      "id": "footer-branding",
      "anchor": { "x": 2, "y": 84.4, "w": 50, "h": 2.4 },
      "content": "{{event.organizer.value}}",
      "fontFamily": "Hanken Grotesk",
      "fontSize": 2.2,
      "fontWeight": "600",
      "color": "#66706A",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 1.8
    }
  ]
}
