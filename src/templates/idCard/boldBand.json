{
  "id": "bold-band",
  "name": "Executive Split Badge",
  "designType": "idCard",
  "description": "Premium dual-tone executive pass with crisp white header, prominent circular photo, and deep midnight navy body.",
  "version": 2,
  "size": {
    "name": "CR80 (Standard ID)",
    "widthMm": 85.6,
    "heightMm": 54,
    "bleedMm": 3,
    "safeMarginMm": 5
  },
  "orientation": "portrait",
  "hasFrontBack": false,
  "tags": ["executive", "split", "portrait", "professional", "clean"],
  "supportedRoles": [],
  "elements": [
    {
      "type": "shape",
      "id": "bg-top",
      "anchor": { "x": -3, "y": -3, "w": 60, "h": 43 },
      "shape": "rect",
      "fill": "#ffffff",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "bg-bottom",
      "anchor": { "x": -3, "y": 38, "w": 60, "h": 51 },
      "shape": "rect",
      "fill": "#0b1120",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "bottom-accent-band",
      "anchor": { "x": -3, "y": 82.6, "w": 60, "h": 6 },
      "shape": "rect",
      "fill": "#2563eb",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "subtle-divider",
      "anchor": { "x": 0, "y": 38, "w": 54, "h": 0.5 },
      "shape": "rect",
      "fill": "#3b82f6",
      "fillBinding": "{{role.palette.accent}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 0.8
    },
    {
      "type": "image",
      "id": "svnit-logo",
      "anchor": { "x": 4, "y": 4, "w": 9.5, "h": 9.5 },
      "src": "/assets/svnit-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "image",
      "id": "acm-logo",
      "anchor": { "x": 40.5, "y": 4, "w": 9.5, "h": 9.5 },
      "src": "/assets/acm-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "text",
      "id": "organizer-subheading",
      "anchor": { "x": 14, "y": 4, "w": 26, "h": 4 },
      "content": "ACM NIT SURAT",
      "fontFamily": "Space Grotesk",
      "fontSize": 4.5,
      "fontWeight": "700",
      "color": "#64748b",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "text",
      "id": "event-name-header",
      "anchor": { "x": 14, "y": 8.5, "w": 26, "h": 5.5 },
      "content": "{{event.name.value}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 6,
      "fontWeight": "700",
      "color": "#0f172a",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 4.5
    },
    {
      "type": "shape",
      "id": "photo-ring",
      "anchor": { "x": 14.5, "y": 18, "w": 25, "h": 25 },
      "shape": "circle",
      "fill": "#ffffff",
      "stroke": "#2563eb",
      "strokeBinding": "{{role.palette.primary}}",
      "strokeWidth": 1.2,
      "cornerRadius": 12.5,
      "opacity": 1
    },
    {
      "type": "image",
      "id": "person-photo",
      "anchor": { "x": 15.5, "y": 19, "w": 23, "h": 23 },
      "src": "{{person.photoUrl}}",
      "fit": "cover",
      "cornerRadius": 11.5,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": false
    },
    {
      "type": "text",
      "id": "person-name",
      "anchor": { "x": 3, "y": 46.5, "w": 48, "h": 7.5 },
      "content": "{{person.name}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 8.5,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 6
    },
    {
      "type": "shape",
      "id": "role-badge",
      "anchor": { "x": 13, "y": 55, "w": 28, "h": 5 },
      "shape": "rect",
      "fill": "#2563eb",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 2.5,
      "opacity": 1
    },
    {
      "type": "text",
      "id": "role-label",
      "anchor": { "x": 13, "y": 55, "w": 28, "h": 5 },
      "content": "{{role.label}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 4.5,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "text",
      "id": "person-team",
      "anchor": { "x": 3, "y": 62, "w": 48, "h": 4.5 },
      "content": "{{person.team}}",
      "fontFamily": "Inter",
      "fontSize": 4.5,
      "fontWeight": "500",
      "color": "#94a3b8",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "text",
      "id": "event-venue-date",
      "anchor": { "x": 3, "y": 67.5, "w": 48, "h": 4 },
      "content": "{{event.venue.value}} • {{event.dateStart.value}}",
      "fontFamily": "Inter",
      "fontSize": 3.8,
      "fontWeight": "400",
      "color": "#64748b",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3
    },
    {
      "type": "qr",
      "id": "person-qr",
      "anchor": { "x": 22, "y": 72.5, "w": 10, "h": 10 },
      "value": "{{person.id}}",
      "fgColor": "#ffffff",
      "bgColor": "transparent"
    },
    {
      "type": "text",
      "id": "person-id-footer",
      "anchor": { "x": 3, "y": 82.5, "w": 48, "h": 3.5 },
      "content": "ID: {{person.id}} • ACM STUDENT CHAPTER",
      "fontFamily": "Space Grotesk",
      "fontSize": 3.5,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3
    }
  ]
}
