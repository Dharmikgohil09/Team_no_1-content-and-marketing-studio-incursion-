{
  "id": "bold-band",
  "name": "Bold Band",
  "designType": "idCard",
  "description": "Strong header band with role color, photo on left, clean information layout. High-impact, professional.",
  "version": 1,
  "size": {
    "name": "CR80 (Standard ID)",
    "widthMm": 85.6,
    "heightMm": 54,
    "bleedMm": 3,
    "safeMarginMm": 5
  },
  "orientation": "landscape",
  "hasFrontBack": false,
  "tags": ["bold", "colorful", "professional", "band"],
  "supportedRoles": [],
  "elements": [
    {
      "type": "shape",
      "id": "header-band",
      "anchor": { "x": 0, "y": 0, "w": 85.6, "h": 14 },
      "shape": "rect",
      "fill": "#1a35de",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "accent-stripe",
      "anchor": { "x": 0, "y": 14, "w": 85.6, "h": 2 },
      "shape": "rect",
      "fill": "#5f90ff",
      "fillBinding": "{{role.palette.accent}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "image",
      "id": "acm-logo",
      "anchor": { "x": 3, "y": 1.5, "w": 10, "h": 10 },
      "src": "/assets/acm-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "image",
      "id": "svnit-logo",
      "anchor": { "x": 72, "y": 1.5, "w": 10, "h": 10 },
      "src": "/assets/svnit-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "text",
      "id": "event-name-header",
      "anchor": { "x": 14, "y": 2, "w": 57, "h": 6 },
      "content": "{{event.name.value}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 8,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 6
    },
    {
      "type": "text",
      "id": "organizer-subheading",
      "anchor": { "x": 14, "y": 8.5, "w": 57, "h": 4 },
      "content": "ACM NIT Surat",
      "fontFamily": "Inter",
      "fontSize": 6,
      "fontWeight": "400",
      "color": "#e0e7ff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5
    },
    {
      "type": "photo",
      "id": "person-photo",
      "anchor": { "x": 4, "y": 18, "w": 24, "h": 24 },
      "binding": "{{person.photoUrl}}",
      "shape": "circle",
      "cornerRadius": 0,
      "fallback": "initials",
      "initialsBinding": "{{person.name}}",
      "initialsColor": "#ffffff",
      "initialsBg": "{{role.palette.primary}}"
    },
    {
      "type": "text",
      "id": "person-name",
      "anchor": { "x": 31, "y": 18, "w": 51, "h": 10 },
      "content": "{{person.name}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 11,
      "fontWeight": "700",
      "color": "#0f111a",
      "align": "left",
      "verticalAlign": "top",
      "maxLines": 2,
      "minFontSize": 7
    },
    {
      "type": "text",
      "id": "role-label",
      "anchor": { "x": 31, "y": 29, "w": 51, "h": 6 },
      "content": "{{role.label}}",
      "fontFamily": "Inter",
      "fontSize": 8,
      "fontWeight": "600",
      "color": "#1a35de",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 6,
      "roleConditional": {
        "participant": { "color": "#1a35de" },
        "organizer":   { "color": "#7c3aed" },
        "mentor":      { "color": "#065f46" },
        "volunteer":   { "color": "#b45309" },
        "speaker":     { "color": "#be123c" }
      }
    },
    {
      "type": "text",
      "id": "person-team",
      "anchor": { "x": 31, "y": 36, "w": 51, "h": 5 },
      "content": "{{person.team}}",
      "fontFamily": "Inter",
      "fontSize": 6.5,
      "fontWeight": "400",
      "color": "#475569",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5
    },
    {
      "type": "text",
      "id": "person-id",
      "anchor": { "x": 4, "y": 44, "w": 40, "h": 5 },
      "content": "ID: {{person.id}}",
      "fontFamily": "JetBrains Mono",
      "fontSize": 6,
      "fontWeight": "500",
      "color": "#64748b",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5
    },
    {
      "type": "qr",
      "id": "qr-code",
      "anchor": { "x": 68, "y": 18, "w": 14, "h": 14 },
      "urlPattern": "https://example.com/attendance?id={{person.id}}",
      "errorCorrection": "M",
      "fgColor": "#0f111a",
      "bgColor": "#ffffff"
    },
    {
      "type": "text",
      "id": "event-date",
      "anchor": { "x": 4, "y": 49, "w": 77, "h": 4 },
      "content": "{{event.dateStart.value}} · {{event.venue.value}}",
      "fontFamily": "Inter",
      "fontSize": 5.5,
      "fontWeight": "400",
      "color": "#94a3b8",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5
    }
  ]
}
