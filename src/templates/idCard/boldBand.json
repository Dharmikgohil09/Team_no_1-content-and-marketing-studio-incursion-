{
  "id": "bold-band",
  "name": "Executive Split Badge",
  "designType": "idCard",
  "description": "Dual-tone dark card with large portrait photo area, role accent band, and corner logos.",
  "version": 3,
  "size": {
    "name": "CR80 (Standard ID)",
    "widthMm": 85.6,
    "heightMm": 54,
    "bleedMm": 3,
    "safeMarginMm": 5
  },
  "orientation": "portrait",
  "hasFrontBack": false,
  "tags": ["executive", "split", "portrait", "professional", "dark"],
  "supportedRoles": [],
  "elements": [
    {
      "type": "shape",
      "id": "bg-full",
      "anchor": { "x": 0, "y": 0, "w": 54, "h": 85.6 },
      "shape": "rect",
      "fill": "#0d1117",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "role-accent-stripe",
      "anchor": { "x": 38, "y": 0, "w": 16, "h": 85.6 },
      "shape": "rect",
      "fill": "#2563eb",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "photo-area-bg",
      "anchor": { "x": 0, "y": 0, "w": 38, "h": 55 },
      "shape": "rect",
      "fill": "#1a1f2e",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "photo",
      "id": "person-photo",
      "anchor": { "x": 0, "y": 0, "w": 38, "h": 52 },
      "binding": "{{person.photoUrl}}",
      "shape": "square",
      "cornerRadius": 0,
      "fallback": "initials",
      "initialsBinding": "{{person.name}}",
      "initialsColor": "#ffffff",
      "initialsBg": "{{role.palette.primary}}"
    },
    {
      "type": "shape",
      "id": "info-bg",
      "anchor": { "x": 0, "y": 55, "w": 38, "h": 30.6 },
      "shape": "rect",
      "fill": "#0d1117",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "text",
      "id": "person-name",
      "anchor": { "x": 2, "y": 56, "w": 34, "h": 8 },
      "content": "{{person.name}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 8,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 2,
      "minFontSize": 5
    },
    {
      "type": "text",
      "id": "role-label",
      "anchor": { "x": 2, "y": 65, "w": 34, "h": 5 },
      "content": "{{role.label}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 5,
      "fontWeight": "600",
      "color": "#2563eb",
      "roleConditional": {
        "participant": { "color": "#60a5fa" },
        "organizer":   { "color": "#c084fc" },
        "mentor":      { "color": "#34d399" },
        "volunteer":   { "color": "#fbbf24" },
        "speaker":     { "color": "#fb7185" }
      },
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "text",
      "id": "event-name",
      "anchor": { "x": 2, "y": 71, "w": 34, "h": 4.5 },
      "content": "{{event.name.value}}",
      "fontFamily": "Inter",
      "fontSize": 4,
      "fontWeight": "500",
      "color": "#94a3b8",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3
    },
    {
      "type": "text",
      "id": "event-venue-date",
      "anchor": { "x": 2, "y": 76, "w": 34, "h": 4 },
      "content": "{{event.venue.value}} · {{event.dateStart.value}}",
      "fontFamily": "Inter",
      "fontSize": 3.5,
      "fontWeight": "400",
      "color": "#64748b",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3
    },
    {
      "type": "image",
      "id": "svnit-logo",
      "anchor": { "x": 39.5, "y": 3, "w": 12, "h": 12 },
      "src": "/assets/svnit-logo.svg",
      "fit": "contain",
      "cornerRadius": 6,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "image",
      "id": "acm-logo",
      "anchor": { "x": 39.5, "y": 17, "w": 12, "h": 12 },
      "src": "/assets/acm-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "text",
      "id": "acm-label",
      "anchor": { "x": 38.5, "y": 30, "w": 14, "h": 8 },
      "content": "ACM NIT SURAT",
      "fontFamily": "Space Grotesk",
      "fontSize": 3.5,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 2,
      "minFontSize": 2.5
    },
    {
      "type": "qr",
      "id": "person-qr",
      "anchor": { "x": 39.5, "y": 63, "w": 12, "h": 12 },
      "urlPattern": "https://acm.svnit.ac.in/verify/{{person.id}}",
      "fgColor": "#ffffff",
      "bgColor": "transparent"
    },
    {
      "type": "text",
      "id": "scan-label",
      "anchor": { "x": 38, "y": 76, "w": 16, "h": 4 },
      "content": "SCAN ID",
      "fontFamily": "Space Grotesk",
      "fontSize": 3,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2.5
    },
    {
      "type": "text",
      "id": "person-id",
      "anchor": { "x": 38, "y": 80, "w": 16, "h": 4 },
      "content": "{{person.id}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 3,
      "fontWeight": "500",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2.5
    }
  ]
}
