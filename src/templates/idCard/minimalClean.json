{
  "id": "minimal-clean",
  "name": "Minimal Clean",
  "designType": "idCard",
  "description": "White-space dominant, subtle left sidebar for role color, elegant typography. Great for corporate events.",
  "version": 1,
  "size": {
    "name": "CR80 (Standard ID)",
    "widthMm": 85.6,
    "heightMm": 54,
    "bleedMm": 3,
    "safeMarginMm": 5
  },
  "orientation": "landscape",
  "hasFrontBack": false,
  "tags": ["minimal", "clean", "whitespace", "elegant"],
  "supportedRoles": [],
  "elements": [
    {
      "type": "shape",
      "id": "bg",
      "anchor": { "x": 0, "y": 0, "w": 85.6, "h": 54 },
      "shape": "rect",
      "fill": "#f8fafc",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "role-sidebar",
      "anchor": { "x": 0, "y": 0, "w": 6, "h": 54 },
      "shape": "rect",
      "fill": "#1a35de",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "bottom-line",
      "anchor": { "x": 6, "y": 48, "w": 79.6, "h": 0.5 },
      "shape": "rect",
      "fill": "#e2e8f0",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "image",
      "id": "acm-logo",
      "anchor": { "x": 9, "y": 3, "w": 10, "h": 10 },
      "src": "/assets/acm-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "image",
      "id": "svnit-logo",
      "anchor": { "x": 21, "y": 3, "w": 10, "h": 10 },
      "src": "/assets/svnit-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "text",
      "id": "event-name-header",
      "anchor": { "x": 33, "y": 4, "w": 48, "h": 5 },
      "content": "{{event.name.value}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 7,
      "fontWeight": "600",
      "color": "#1e293b",
      "align": "right",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5
    },
    {
      "type": "text",
      "id": "organizer-text",
      "anchor": { "x": 33, "y": 9.5, "w": 48, "h": 4 },
      "content": "ACM NIT Surat",
      "fontFamily": "Inter",
      "fontSize": 5.5,
      "fontWeight": "400",
      "color": "#64748b",
      "align": "right",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5
    },
    {
      "type": "shape",
      "id": "divider",
      "anchor": { "x": 9, "y": 14.5, "w": 76.6, "h": 0.25 },
      "shape": "rect",
      "fill": "#e2e8f0",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "photo",
      "id": "person-photo",
      "anchor": { "x": 9, "y": 17, "w": 18, "h": 18 },
      "binding": "{{person.photoUrl}}",
      "shape": "rounded",
      "cornerRadius": 3,
      "fallback": "initials",
      "initialsBinding": "{{person.name}}",
      "initialsColor": "#ffffff",
      "initialsBg": "{{role.palette.primary}}"
    },
    {
      "type": "text",
      "id": "person-name",
      "anchor": { "x": 30, "y": 17, "w": 52, "h": 9 },
      "content": "{{person.name}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 10,
      "fontWeight": "700",
      "color": "#0f172a",
      "align": "left",
      "verticalAlign": "top",
      "maxLines": 2,
      "minFontSize": 7
    },
    {
      "type": "text",
      "id": "role-label",
      "anchor": { "x": 30, "y": 27, "w": 52, "h": 5 },
      "content": "{{role.label}}",
      "fontFamily": "Inter",
      "fontSize": 7,
      "fontWeight": "500",
      "color": "#1a35de",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 6,
      "roleConditional": {
        "participant": { "color": "#1a35de" },
        "organizer":   { "color": "#7c3aed" },
        "mentor":      { "color": "#065f46" },
        "volunteer":   { "color": "#b45309" },
        "speaker":     { "color": "#be123c" }
      }
    },
    {
      "type": "text",
      "id": "person-email",
      "anchor": { "x": 30, "y": 33, "w": 52, "h": 4 },
      "content": "{{person.email}}",
      "fontFamily": "Inter",
      "fontSize": 6,
      "fontWeight": "400",
      "color": "#64748b",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5
    },
    {
      "type": "text",
      "id": "person-team",
      "anchor": { "x": 30, "y": 37.5, "w": 52, "h": 4 },
      "content": "{{person.team}}",
      "fontFamily": "Inter",
      "fontSize": 6,
      "fontWeight": "400",
      "color": "#94a3b8",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5
    },
    {
      "type": "text",
      "id": "person-id",
      "anchor": { "x": 9, "y": 37, "w": 18, "h": 4 },
      "content": "{{person.id}}",
      "fontFamily": "JetBrains Mono",
      "fontSize": 6,
      "fontWeight": "500",
      "color": "#64748b",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5
    },
    {
      "type": "qr",
      "id": "qr-code",
      "anchor": { "x": 68, "y": 37, "w": 12, "h": 12 },
      "urlPattern": "https://example.com/attendance?id={{person.id}}",
      "errorCorrection": "M",
      "fgColor": "#0f172a",
      "bgColor": "#f8fafc"
    },
    {
      "type": "text",
      "id": "event-footer",
      "anchor": { "x": 9, "y": 49.5, "w": 76.6, "h": 4 },
      "content": "{{event.dateStart.value}} · {{event.venue.value}}",
      "fontFamily": "Inter",
      "fontSize": 5,
      "fontWeight": "400",
      "color": "#94a3b8",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 4.5
    }
  ]
}
