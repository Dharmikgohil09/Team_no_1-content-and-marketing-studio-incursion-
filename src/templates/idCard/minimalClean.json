{
  "id": "minimal-clean",
  "name": "Matte Obsidian Accent",
  "designType": "idCard",
  "description": "Dark matte card with offset photo block and bold role-color vertical accent stripe. Reference: Ada Balogun style.",
  "version": 3,
  "size": {
    "name": "CR80 (Standard ID)",
    "widthMm": 85.6,
    "heightMm": 54,
    "bleedMm": 3,
    "safeMarginMm": 5
  },
  "orientation": "portrait",
  "hasFrontBack": false,
  "tags": ["matte", "minimal", "bold", "obsidian", "portrait"],
  "supportedRoles": [],
  "elements": [
    {
      "type": "shape",
      "id": "bg-dark",
      "anchor": { "x": 0, "y": 0, "w": 54, "h": 85.6 },
      "shape": "rect",
      "fill": "#0f1117",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "photo",
      "id": "person-photo",
      "anchor": { "x": 0, "y": 0, "w": 38, "h": 50 },
      "binding": "{{person.photoUrl}}",
      "shape": "square",
      "cornerRadius": 0,
      "fallback": "initials",
      "initialsBinding": "{{person.name}}",
      "initialsColor": "#ffffff",
      "initialsBg": "{{role.palette.primary}}"
    },
    {
      "type": "shape",
      "id": "role-color-block",
      "anchor": { "x": 38, "y": 10, "w": 16, "h": 40 },
      "shape": "rect",
      "fill": "#ef4444",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "bottom-info-bg",
      "anchor": { "x": 0, "y": 50, "w": 54, "h": 35.6 },
      "shape": "rect",
      "fill": "#0f1117",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "text",
      "id": "person-name",
      "anchor": { "x": 2, "y": 51, "w": 38, "h": 9 },
      "content": "{{person.name}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 9,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 2,
      "minFontSize": 5
    },
    {
      "type": "text",
      "id": "role-label",
      "anchor": { "x": 2, "y": 61, "w": 38, "h": 5 },
      "content": "{{role.label}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 5,
      "fontWeight": "600",
      "color": "#ef4444",
      "roleConditional": {
        "participant": { "color": "#60a5fa" },
        "organizer":   { "color": "#c084fc" },
        "mentor":      { "color": "#34d399" },
        "volunteer":   { "color": "#fbbf24" },
        "speaker":     { "color": "#fb7185" }
      },
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "text",
      "id": "event-name",
      "anchor": { "x": 2, "y": 67, "w": 38, "h": 4 },
      "content": "{{event.name.value}}",
      "fontFamily": "Inter",
      "fontSize": 4,
      "fontWeight": "500",
      "color": "#94a3b8",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3
    },
    {
      "type": "shape",
      "id": "divider-line",
      "anchor": { "x": 2, "y": 72, "w": 34, "h": 0.4 },
      "shape": "rect",
      "fill": "#1e293b",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "image",
      "id": "svnit-logo",
      "anchor": { "x": 2, "y": 74, "w": 9, "h": 9 },
      "src": "/assets/svnit-logo.svg",
      "fit": "contain",
      "cornerRadius": 4.5,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "image",
      "id": "acm-logo",
      "anchor": { "x": 13, "y": 74, "w": 9, "h": 9 },
      "src": "/assets/acm-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "text",
      "id": "website-label",
      "anchor": { "x": 24, "y": 74, "w": 28, "h": 9 },
      "content": "acm.svnit.ac.in",
      "fontFamily": "Space Grotesk",
      "fontSize": 3.5,
      "fontWeight": "500",
      "color": "#64748b",
      "align": "right",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3
    },
    {
      "type": "shape",
      "id": "logo-top-strip",
      "anchor": { "x": 38, "y": 0, "w": 16, "h": 10 },
      "shape": "rect",
      "fill": "#1a1f2e",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "logo-bottom-strip",
      "anchor": { "x": 38, "y": 50, "w": 16, "h": 35.6 },
      "shape": "rect",
      "fill": "#1a1f2e",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    }
  ]
}
