{
  "id": "minimal-clean",
  "name": "Matte Obsidian Accent",
  "designType": "idCard",
  "description": "High-fashion minimalist badge with matte dark backdrop, offset portrait frame, and bold role-color accent block.",
  "version": 2,
  "size": {
    "name": "CR80 (Standard ID)",
    "widthMm": 85.6,
    "heightMm": 54,
    "bleedMm": 3,
    "safeMarginMm": 5
  },
  "orientation": "portrait",
  "hasFrontBack": false,
  "tags": ["matte", "minimal", "bold", "obsidian", "portrait"],
  "supportedRoles": [],
  "elements": [
    {
      "type": "shape",
      "id": "bg-dark",
      "anchor": { "x": -3, "y": -3, "w": 60, "h": 92 },
      "shape": "rect",
      "fill": "#0f1117",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "role-color-block",
      "anchor": { "x": 34, "y": 14, "w": 15, "h": 36 },
      "shape": "rect",
      "fill": "#f43f5e",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 2,
      "opacity": 1
    },
    {
      "type": "image",
      "id": "svnit-logo",
      "anchor": { "x": 5, "y": 4, "w": 8.5, "h": 8.5 },
      "src": "/assets/svnit-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "image",
      "id": "acm-logo",
      "anchor": { "x": 40.5, "y": 4, "w": 8.5, "h": 8.5 },
      "src": "/assets/acm-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "text",
      "id": "event-name-header",
      "anchor": { "x": 14, "y": 4, "w": 26, "h": 5 },
      "content": "{{event.name.value}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 5,
      "fontWeight": "700",
      "color": "#94a3b8",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 4
    },
    {
      "type": "image",
      "id": "person-photo",
      "anchor": { "x": 5, "y": 14, "w": 28, "h": 36 },
      "src": "{{person.photoUrl}}",
      "fit": "cover",
      "cornerRadius": 2.5,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": false
    },
    {
      "type": "text",
      "id": "person-name",
      "anchor": { "x": 5, "y": 52.5, "w": 44, "h": 7.5 },
      "content": "{{person.name}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 8.5,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 6
    },
    {
      "type": "text",
      "id": "role-label",
      "anchor": { "x": 5, "y": 60, "w": 44, "h": 4.5 },
      "content": "{{role.label}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 5,
      "fontWeight": "600",
      "color": "#f43f5e",
      "roleConditional": {
        "participant": { "color": "#60a5fa" },
        "organizer":   { "color": "#c084fc" },
        "mentor":      { "color": "#34d399" },
        "volunteer":   { "color": "#fbbf24" },
        "speaker":     { "color": "#fb7185" }
      },
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "text",
      "id": "person-team",
      "anchor": { "x": 5, "y": 65, "w": 44, "h": 4 },
      "content": "{{person.team}}",
      "fontFamily": "Inter",
      "fontSize": 4,
      "fontWeight": "500",
      "color": "#94a3b8",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3
    },
    {
      "type": "text",
      "id": "event-venue-date",
      "anchor": { "x": 5, "y": 69.5, "w": 44, "h": 4 },
      "content": "{{event.venue.value}} • {{event.dateStart.value}}",
      "fontFamily": "Inter",
      "fontSize": 3.6,
      "fontWeight": "400",
      "color": "#64748b",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3
    },
    {
      "type": "qr",
      "id": "person-qr",
      "anchor": { "x": 38.5, "y": 74, "w": 10, "h": 10 },
      "value": "{{person.id}}",
      "fgColor": "#ffffff",
      "bgColor": "transparent"
    },
    {
      "type": "text",
      "id": "person-id-footer",
      "anchor": { "x": 5, "y": 77, "w": 32, "h": 4 },
      "content": "svnit.ac.in • ID: {{person.id}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 3.5,
      "fontWeight": "500",
      "color": "#64748b",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3
    }
  ]
}
