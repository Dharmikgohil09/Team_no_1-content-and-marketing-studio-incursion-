{
  "id": "minimal-clean",
  "name": "Editorial Asymmetric Pass",
  "designType": "idCard",
  "description": "Warm editorial paper pass with asymmetric rectangular photo, striking vertical role accent block, and editorial typography.",
  "version": 5,
  "size": {
    "name": "CR80",
    "widthMm": 54,
    "heightMm": 85.6,
    "bleedMm": 0,
    "safeMarginMm": 3
  },
  "orientation": "portrait",
  "hasFrontBack": true,
  "tags": ["editorial", "asymmetric", "accent-block", "prestige", "paper"],
  "supportedRoles": ["participant", "organizer", "mentor", "volunteer", "judge", "speaker"],
  "elements": [
    {
      "type": "shape",
      "id": "card-dark-frame",
      "anchor": { "x": 0, "y": 0, "w": 54, "h": 85.6 },
      "shape": "rect",
      "fill": "#FAF8F4",
      "stroke": "#D9D5C7",
      "strokeWidth": 0.45,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "lanyard-slot",
      "anchor": { "x": 22, "y": 2, "w": 10, "h": 2.5 },
      "shape": "rect",
      "fill": "#E9E5D8",
      "stroke": "#D9D5C7",
      "strokeWidth": 0.35,
      "cornerRadius": 1.25,
      "opacity": 1
    },
    {
      "type": "image",
      "id": "acm-logo",
      "anchor": { "x": 4, "y": 6, "w": 7.5, "h": 7.5 },
      "src": "/assets/acm-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "image",
      "id": "svnit-logo",
      "anchor": { "x": 42.5, "y": 6, "w": 7.5, "h": 7.5 },
      "src": "/assets/svnit-logo.svg",
      "fit": "contain",
      "cornerRadius": 3.75,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "text",
      "id": "header-category",
      "anchor": { "x": 12.5, "y": 6.2, "w": 29, "h": 3.5 },
      "content": "{{event.name.value}}",
      "fontFamily": "Instrument Serif",
      "fontSize": 5.5,
      "fontWeight": "400",
      "color": "#14201C",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.6
    },
    {
      "type": "text",
      "id": "header-acm-label",
      "anchor": { "x": 12.5, "y": 9.8, "w": 29, "h": 3 },
      "content": "ACM NIT SURAT",
      "fontFamily": "Hanken Grotesk",
      "fontSize": 2.6,
      "fontWeight": "600",
      "color": "#0F5C4D",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2,
      "roleConditional": {
        "organizer": { "color": "#14201C" },
        "mentor":    { "color": "#8B5E3C" },
        "speaker":   { "color": "#7B3833" },
        "judge":     { "color": "#3B4842" },
        "volunteer": { "color": "#2E5A44" }
      }
    },
    {
      "type": "shape",
      "id": "photo-frame-bg",
      "anchor": { "x": 4, "y": 14, "w": 31, "h": 38 },
      "shape": "rect",
      "fill": "#E9E5D8",
      "stroke": "#D9D5C7",
      "strokeWidth": 0.35,
      "cornerRadius": 1.2,
      "opacity": 1
    },
    {
      "type": "photo",
      "id": "person-photo",
      "anchor": { "x": 4, "y": 14, "w": 31, "h": 38 },
      "binding": "{{person.photoUrl}}",
      "shape": "rounded",
      "cornerRadius": 1.2,
      "fallback": "initials",
      "initialsBinding": "{{person.name}}",
      "initialsColor": "#ffffff",
      "initialsBg": "{{role.palette.primary}}"
    },
    {
      "type": "shape",
      "id": "vertical-accent-block",
      "anchor": { "x": 36.5, "y": 14, "w": 13.5, "h": 38 },
      "shape": "rect",
      "fill": "#0F5C4D",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "text",
      "id": "block-serial",
      "anchor": { "x": 37, "y": 16.5, "w": 12.5, "h": 3.5 },
      "content": "ID-{{person.id}}",
      "fontFamily": "Hanken Grotesk",
      "fontSize": 2.4,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 1.8
    },
    {
      "type": "qr",
      "id": "block-qr",
      "anchor": { "x": 38.5, "y": 40.5, "w": 9.5, "h": 9.5 },
      "urlPattern": "https://acm.svnit.ac.in/verify/{{person.id}}",
      "fgColor": "#ffffff",
      "bgColor": "transparent",
      "errorCorrection": "M"
    },
    {
      "type": "text",
      "id": "person-name",
      "anchor": { "x": 4, "y": 54.5, "w": 46, "h": 8.2 },
      "content": "{{person.name}}",
      "fontFamily": "Instrument Serif",
      "fontSize": 9.2,
      "fontWeight": "400",
      "color": "#14201C",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 2,
      "minFontSize": 6.5
    },
    {
      "type": "text",
      "id": "role-label",
      "anchor": { "x": 4, "y": 63.5, "w": 46, "h": 4.8 },
      "content": "{{role.label}}",
      "fontFamily": "Hanken Grotesk",
      "fontSize": 4.8,
      "fontWeight": "700",
      "color": "#0F5C4D",
      "roleConditional": {
        "participant": { "color": "#0F5C4D" },
        "organizer":   { "color": "#14201C" },
        "mentor":      { "color": "#8B5E3C" },
        "volunteer":   { "color": "#2E5A44" },
        "judge":       { "color": "#3B4842" },
        "speaker":     { "color": "#7B3833" }
      },
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "text",
      "id": "person-team",
      "anchor": { "x": 4, "y": 68.5, "w": 46, "h": 4 },
      "content": "{{person.team}}",
      "fontFamily": "Hanken Grotesk",
      "fontSize": 3.8,
      "fontWeight": "500",
      "color": "#4B5651",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2.8
    },
    {
      "type": "text",
      "id": "event-name",
      "anchor": { "x": 4, "y": 73, "w": 46, "h": 3.5 },
      "content": "{{event.venue.value}} - {{event.dateStart.value}}",
      "fontFamily": "Hanken Grotesk",
      "fontSize": 3.3,
      "fontWeight": "400",
      "color": "#66706A",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2.5
    },
    {
      "type": "shape",
      "id": "footer-divider",
      "anchor": { "x": 4, "y": 77, "w": 46, "h": 0.35 },
      "shape": "line",
      "fill": "transparent",
      "stroke": "#D9D5C7",
      "strokeWidth": 0.35,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "text",
      "id": "website-url",
      "anchor": { "x": 4, "y": 78.5, "w": 46, "h": 4 },
      "content": "acm.svnit.ac.in",
      "fontFamily": "Hanken Grotesk",
      "fontSize": 3.2,
      "fontWeight": "500",
      "color": "#66706A",
      "align": "right",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2.2
    }
  ]
}
