{
  "id": "modern-gradient",
  "name": "Tech Indigo Pass",
  "designType": "idCard",
  "description": "Futuristic conference & hackathon badge with royal purple tech header, glowing circular avatar, and clean white credential section.",
  "version": 2,
  "size": {
    "name": "CR80 (Standard ID)",
    "widthMm": 85.6,
    "heightMm": 54,
    "bleedMm": 3,
    "safeMarginMm": 5
  },
  "orientation": "portrait",
  "hasFrontBack": false,
  "tags": ["tech", "purple", "chevron", "hackathon", "modern"],
  "supportedRoles": [],
  "elements": [
    {
      "type": "shape",
      "id": "bg-top",
      "anchor": { "x": -3, "y": -3, "w": 60, "h": 61 },
      "shape": "rect",
      "fill": "#1b1145",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "bg-bottom",
      "anchor": { "x": -3, "y": 57, "w": 60, "h": 32 },
      "shape": "rect",
      "fill": "#ffffff",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "hero-band",
      "anchor": { "x": -3, "y": 81.6, "w": 60, "h": 7 },
      "shape": "rect",
      "fill": "#7c3aed",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "image",
      "id": "svnit-logo",
      "anchor": { "x": 4, "y": 4, "w": 9.5, "h": 9.5 },
      "src": "/assets/svnit-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "image",
      "id": "acm-logo",
      "anchor": { "x": 40.5, "y": 4, "w": 9.5, "h": 9.5 },
      "src": "/assets/acm-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "text",
      "id": "event-name-header",
      "anchor": { "x": 14, "y": 4, "w": 26, "h": 5.5 },
      "content": "{{event.name.value}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 6,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 4.5
    },
    {
      "type": "text",
      "id": "organizer-subheading",
      "anchor": { "x": 14, "y": 9, "w": 26, "h": 4 },
      "content": "ACM NIT SURAT",
      "fontFamily": "Space Grotesk",
      "fontSize": 4,
      "fontWeight": "600",
      "color": "#c4b5fd",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "shape",
      "id": "photo-ring",
      "anchor": { "x": 15, "y": 16.5, "w": 24, "h": 24 },
      "shape": "circle",
      "fill": "#ffffff",
      "stroke": "#7c3aed",
      "strokeBinding": "{{role.palette.primary}}",
      "strokeWidth": 1.2,
      "cornerRadius": 12,
      "opacity": 1
    },
    {
      "type": "image",
      "id": "person-photo",
      "anchor": { "x": 16, "y": 17.5, "w": 22, "h": 22 },
      "src": "{{person.photoUrl}}",
      "fit": "cover",
      "cornerRadius": 11,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": false
    },
    {
      "type": "text",
      "id": "person-name",
      "anchor": { "x": 3, "y": 42.5, "w": 48, "h": 7 },
      "content": "{{person.name}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 8.5,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 6
    },
    {
      "type": "shape",
      "id": "role-badge",
      "anchor": { "x": 13, "y": 50.5, "w": 28, "h": 5 },
      "shape": "rect",
      "fill": "#7c3aed",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 2.5,
      "opacity": 1
    },
    {
      "type": "text",
      "id": "role-label",
      "anchor": { "x": 13, "y": 50.5, "w": 28, "h": 5 },
      "content": "{{role.label}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 4.5,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "text",
      "id": "person-team",
      "anchor": { "x": 3, "y": 60, "w": 48, "h": 4.5 },
      "content": "{{person.team}}",
      "fontFamily": "Inter",
      "fontSize": 4.5,
      "fontWeight": "600",
      "color": "#1e293b",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "text",
      "id": "event-venue-date",
      "anchor": { "x": 3, "y": 65, "w": 48, "h": 4 },
      "content": "{{event.venue.value}} • {{event.dateStart.value}}",
      "fontFamily": "Inter",
      "fontSize": 3.8,
      "fontWeight": "400",
      "color": "#64748b",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3
    },
    {
      "type": "qr",
      "id": "person-qr",
      "anchor": { "x": 22, "y": 70, "w": 10, "h": 10 },
      "value": "{{person.id}}",
      "fgColor": "#0f172a",
      "bgColor": "transparent"
    },
    {
      "type": "text",
      "id": "person-id-footer",
      "anchor": { "x": 3, "y": 82, "w": 48, "h": 3.5 },
      "content": "ID: {{person.id}} • SVNIT SURAT",
      "fontFamily": "Space Grotesk",
      "fontSize": 3.5,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3
    }
  ]
}
