{
  "id": "modern-gradient",
  "name": "Modern Gradient",
  "designType": "idCard",
  "description": "Dark gradient background with geometric accent shapes, circular photo, premium feel. Ideal for tech events.",
  "version": 1,
  "size": {
    "name": "CR80 (Standard ID)",
    "widthMm": 85.6,
    "heightMm": 54,
    "bleedMm": 3,
    "safeMarginMm": 5
  },
  "orientation": "landscape",
  "hasFrontBack": false,
  "tags": ["modern", "gradient", "dark", "geometric", "premium"],
  "supportedRoles": [],
  "elements": [
    {
      "type": "shape",
      "id": "bg-dark",
      "anchor": { "x": 0, "y": 0, "w": 85.6, "h": 54 },
      "shape": "rect",
      "fill": "#0f111a",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "geo-circle-1",
      "anchor": { "x": 55, "y": -15, "w": 50, "h": 50 },
      "shape": "circle",
      "fill": "#1a35de",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 0.25
    },
    {
      "type": "shape",
      "id": "geo-circle-2",
      "anchor": { "x": 65, "y": 20, "w": 35, "h": 35 },
      "shape": "circle",
      "fill": "#5f90ff",
      "fillBinding": "{{role.palette.accent}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 0.15
    },
    {
      "type": "shape",
      "id": "role-indicator",
      "anchor": { "x": 0, "y": 40, "w": 85.6, "h": 14 },
      "shape": "rect",
      "fill": "#1a35de",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 0.9
    },
    {
      "type": "image",
      "id": "acm-logo",
      "anchor": { "x": 3, "y": 2, "w": 10, "h": 10 },
      "src": "/assets/acm-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 0.9,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "image",
      "id": "svnit-logo",
      "anchor": { "x": 14, "y": 2, "w": 10, "h": 10 },
      "src": "/assets/svnit-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 0.9,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "text",
      "id": "event-name-header",
      "anchor": { "x": 26, "y": 2.5, "w": 55, "h": 6 },
      "content": "{{event.name.value}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 7,
      "fontWeight": "600",
      "color": "#e0e7ff",
      "align": "right",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5.5
    },
    {
      "type": "text",
      "id": "organizer-subheading",
      "anchor": { "x": 26, "y": 8.5, "w": 55, "h": 4 },
      "content": "ACM NIT Surat",
      "fontFamily": "Inter",
      "fontSize": 5,
      "fontWeight": "300",
      "color": "#94a3b8",
      "align": "right",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 4.5
    },
    {
      "type": "photo",
      "id": "person-photo",
      "anchor": { "x": 5, "y": 15, "w": 22, "h": 22 },
      "binding": "{{person.photoUrl}}",
      "shape": "circle",
      "cornerRadius": 0,
      "fallback": "initials",
      "initialsBinding": "{{person.name}}",
      "initialsColor": "#ffffff",
      "initialsBg": "{{role.palette.primary}}"
    },
    {
      "type": "shape",
      "id": "photo-ring",
      "anchor": { "x": 4, "y": 14, "w": 24, "h": 24 },
      "shape": "circle",
      "fill": "transparent",
      "stroke": "#5f90ff",
      "fillBinding": "",
      "strokeWidth": 0.8,
      "cornerRadius": 0,
      "opacity": 0.6,
      "roleConditional": {
        "participant": { "stroke": "#5f90ff" },
        "organizer":   { "stroke": "#a78bfa" },
        "mentor":      { "stroke": "#34d399" },
        "volunteer":   { "stroke": "#f59e0b" },
        "speaker":     { "stroke": "#fb7185" }
      }
    },
    {
      "type": "text",
      "id": "person-name",
      "anchor": { "x": 30, "y": 15, "w": 52, "h": 10 },
      "content": "{{person.name}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 11,
      "fontWeight": "700",
      "color": "#f8fafc",
      "align": "left",
      "verticalAlign": "top",
      "maxLines": 2,
      "minFontSize": 7
    },
    {
      "type": "text",
      "id": "person-team",
      "anchor": { "x": 30, "y": 27, "w": 52, "h": 5 },
      "content": "{{person.team}}",
      "fontFamily": "Inter",
      "fontSize": 6.5,
      "fontWeight": "400",
      "color": "#94a3b8",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5
    },
    {
      "type": "text",
      "id": "role-label-footer",
      "anchor": { "x": 4, "y": 41.5, "w": 55, "h": 8 },
      "content": "{{role.label}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 9,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 7
    },
    {
      "type": "text",
      "id": "person-id-footer",
      "anchor": { "x": 4, "y": 47, "w": 55, "h": 5 },
      "content": "ID: {{person.id}}",
      "fontFamily": "JetBrains Mono",
      "fontSize": 6,
      "fontWeight": "400",
      "color": "#c4b5fd",
      "align": "left",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5,
      "roleConditional": {
        "participant": { "color": "#bbd4ff" },
        "organizer":   { "color": "#c4b5fd" },
        "mentor":      { "color": "#6ee7b7" },
        "volunteer":   { "color": "#fcd34d" },
        "speaker":     { "color": "#fda4af" }
      }
    },
    {
      "type": "qr",
      "id": "qr-code",
      "anchor": { "x": 68, "y": 40, "w": 14, "h": 12 },
      "urlPattern": "https://example.com/attendance?id={{person.id}}",
      "errorCorrection": "M",
      "fgColor": "#ffffff",
      "bgColor": "transparent"
    }
  ]
}
