{
  "id": "modern-gradient",
  "name": "Tech Indigo Pass",
  "designType": "idCard",
  "description": "Purple/violet tech badge with circular avatar in top section, chevron divider, and clean credential zone. Reference: BioTech style.",
  "version": 3,
  "size": {
    "name": "CR80 (Standard ID)",
    "widthMm": 85.6,
    "heightMm": 54,
    "bleedMm": 3,
    "safeMarginMm": 5
  },
  "orientation": "portrait",
  "hasFrontBack": false,
  "tags": ["tech", "purple", "chevron", "hackathon", "modern"],
  "supportedRoles": [],
  "elements": [
    {
      "type": "shape",
      "id": "bg-top-purple",
      "anchor": { "x": 0, "y": 0, "w": 54, "h": 54 },
      "shape": "rect",
      "fill": "#1e1145",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "bg-bottom-white",
      "anchor": { "x": 0, "y": 50, "w": 54, "h": 35.6 },
      "shape": "rect",
      "fill": "#f8fafc",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "chevron-shape",
      "anchor": { "x": 0, "y": 44, "w": 54, "h": 14 },
      "shape": "rect",
      "fill": "#f8fafc",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "logo-bg-left",
      "anchor": { "x": 2, "y": 3, "w": 11, "h": 11 },
      "shape": "circle",
      "fill": "#2d1b7a",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 5.5,
      "opacity": 1
    },
    {
      "type": "image",
      "id": "svnit-logo",
      "anchor": { "x": 3, "y": 4, "w": 9, "h": 9 },
      "src": "/assets/svnit-logo.svg",
      "fit": "contain",
      "cornerRadius": 4.5,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "shape",
      "id": "logo-bg-right",
      "anchor": { "x": 41, "y": 3, "w": 11, "h": 11 },
      "shape": "circle",
      "fill": "#2d1b7a",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 5.5,
      "opacity": 1
    },
    {
      "type": "image",
      "id": "acm-logo",
      "anchor": { "x": 42, "y": 4, "w": 9, "h": 9 },
      "src": "/assets/acm-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "text",
      "id": "event-name-header",
      "anchor": { "x": 14, "y": 3, "w": 26, "h": 6 },
      "content": "{{event.name.value}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 5.5,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 4
    },
    {
      "type": "text",
      "id": "acm-subtitle",
      "anchor": { "x": 14, "y": 9, "w": 26, "h": 4.5 },
      "content": "ACM NIT SURAT",
      "fontFamily": "Space Grotesk",
      "fontSize": 4,
      "fontWeight": "600",
      "color": "#c4b5fd",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "shape",
      "id": "photo-ring-outer",
      "anchor": { "x": 13, "y": 15, "w": 28, "h": 28 },
      "shape": "circle",
      "fill": "#2d1b7a",
      "stroke": "#7c3aed",
      "strokeBinding": "{{role.palette.primary}}",
      "strokeWidth": 0.8,
      "cornerRadius": 14,
      "opacity": 1
    },
    {
      "type": "photo",
      "id": "person-photo",
      "anchor": { "x": 15, "y": 17, "w": 24, "h": 24 },
      "binding": "{{person.photoUrl}}",
      "shape": "circle",
      "cornerRadius": 12,
      "fallback": "initials",
      "initialsBinding": "{{person.name}}",
      "initialsColor": "#ffffff",
      "initialsBg": "{{role.palette.primary}}"
    },
    {
      "type": "shape",
      "id": "role-badge-bg",
      "anchor": { "x": 14, "y": 45.5, "w": 26, "h": 6 },
      "shape": "rect",
      "fill": "#7c3aed",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 3,
      "opacity": 1
    },
    {
      "type": "text",
      "id": "role-label",
      "anchor": { "x": 14, "y": 45.5, "w": 26, "h": 6 },
      "content": "{{role.label}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 4.5,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "text",
      "id": "person-name",
      "anchor": { "x": 2, "y": 53, "w": 50, "h": 8 },
      "content": "{{person.name}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 8,
      "fontWeight": "700",
      "color": "#0f172a",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5
    },
    {
      "type": "text",
      "id": "person-team",
      "anchor": { "x": 2, "y": 62, "w": 50, "h": 4.5 },
      "content": "{{person.team}}",
      "fontFamily": "Inter",
      "fontSize": 4.5,
      "fontWeight": "600",
      "color": "#334155",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "text",
      "id": "event-venue-date",
      "anchor": { "x": 2, "y": 67, "w": 50, "h": 4 },
      "content": "{{event.venue.value}} · {{event.dateStart.value}}",
      "fontFamily": "Inter",
      "fontSize": 3.8,
      "fontWeight": "400",
      "color": "#64748b",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3
    },
    {
      "type": "qr",
      "id": "person-qr",
      "anchor": { "x": 22, "y": 72, "w": 10, "h": 10 },
      "urlPattern": "https://acm.svnit.ac.in/verify/{{person.id}}",
      "fgColor": "#1e1145",
      "bgColor": "transparent"
    },
    {
      "type": "text",
      "id": "person-id",
      "anchor": { "x": 2, "y": 83, "w": 50, "h": 3 },
      "content": "ID: {{person.id}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 3,
      "fontWeight": "600",
      "color": "#94a3b8",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2.5
    }
  ]
}
