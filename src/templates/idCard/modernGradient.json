{
  "id": "modern-gradient",
  "name": "Creative Tech Pass",
  "designType": "idCard",
  "description": "Scientific and geometric tech badge with hexagon molecular network, glowing halo avatar, chevron divider, and barcode strip.",
  "version": 5,
  "size": {
    "name": "CR80 (Standard ID 54x86mm)",
    "widthMm": 54,
    "heightMm": 85.6,
    "bleedMm": 3,
    "safeMarginMm": 3
  },
  "orientation": "portrait",
  "hasFrontBack": true,
  "tags": ["creative", "tech", "hexagons", "chevron", "barcode", "hackathon"],
  "supportedRoles": ["participant", "organizer", "mentor", "volunteer", "judge", "speaker"],
  "elements": [
    {
      "type": "shape",
      "id": "tech-hero-bg",
      "anchor": { "x": 0, "y": 0, "w": 54, "h": 48 },
      "shape": "rect",
      "fill": "#160d38",
      "fillBinding": "{{role.palette.secondary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "hex-cluster-1",
      "anchor": { "x": 2, "y": 13, "w": 9, "h": 9 },
      "shape": "polygon",
      "points": "4.5,0 9,2.6 9,7.8 4.5,10.4 0,7.8 0,2.6",
      "fill": "#6d28d9",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "#c084fc",
      "strokeWidth": 0.45,
      "cornerRadius": 0,
      "opacity": 0.38
    },
    {
      "type": "shape",
      "id": "hex-cluster-2",
      "anchor": { "x": 6, "y": 22, "w": 7, "h": 7 },
      "shape": "polygon",
      "points": "3.5,0 7,2 7,6 3.5,8 0,6 0,2",
      "fill": "transparent",
      "stroke": "#c084fc",
      "strokeWidth": 0.35,
      "cornerRadius": 0,
      "opacity": 0.45
    },
    {
      "type": "shape",
      "id": "hex-cluster-3",
      "anchor": { "x": 42, "y": 14, "w": 8, "h": 8 },
      "shape": "polygon",
      "points": "4,0 8,2.3 8,6.9 4,9.2 0,6.9 0,2.3",
      "fill": "transparent",
      "stroke": "#c084fc",
      "strokeWidth": 0.45,
      "cornerRadius": 0,
      "opacity": 0.4
    },
    {
      "type": "shape",
      "id": "circuit-line-1",
      "anchor": { "x": 10, "y": 14.5, "w": 6, "h": 0.4 },
      "shape": "line",
      "fill": "transparent",
      "stroke": "#c084fc",
      "strokeWidth": 0.35,
      "cornerRadius": 0,
      "opacity": 0.5
    },
    {
      "type": "shape",
      "id": "circuit-line-2",
      "anchor": { "x": 37, "y": 21, "w": 6, "h": 0.4 },
      "shape": "line",
      "fill": "transparent",
      "stroke": "#c084fc",
      "strokeWidth": 0.35,
      "cornerRadius": 0,
      "opacity": 0.5
    },
    {
      "type": "image",
      "id": "acm-logo",
      "anchor": { "x": 3, "y": 3.5, "w": 8.5, "h": 8.5 },
      "src": "/assets/acm-logo.svg",
      "fit": "contain",
      "cornerRadius": 0,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "image",
      "id": "svnit-logo",
      "anchor": { "x": 42.5, "y": 3.5, "w": 8.5, "h": 8.5 },
      "src": "/assets/svnit-logo.svg",
      "fit": "contain",
      "cornerRadius": 4.25,
      "opacity": 1,
      "preserveAspectRatio": true,
      "isLogo": true
    },
    {
      "type": "text",
      "id": "event-name-header",
      "anchor": { "x": 12, "y": 3.5, "w": 30, "h": 5 },
      "content": "{{event.name.value}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 4.8,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3.5
    },
    {
      "type": "text",
      "id": "org-subtitle",
      "anchor": { "x": 12, "y": 8.5, "w": 30, "h": 3.5 },
      "content": "ACM NIT SURAT",
      "fontFamily": "Space Grotesk",
      "fontSize": 3.2,
      "fontWeight": "600",
      "color": "#c4b5fd",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2.4,
      "roleConditional": {
        "organizer": { "color": "#f59e0b" },
        "judge":     { "color": "#e2e8f0" },
        "speaker":   { "color": "#fbbf24" }
      }
    },
    {
      "type": "shape",
      "id": "halo-ring",
      "anchor": { "x": 15, "y": 14.5, "w": 24, "h": 24 },
      "shape": "circle",
      "fill": "transparent",
      "stroke": "#c084fc",
      "strokeWidth": 0.85,
      "cornerRadius": 12,
      "opacity": 0.9,
      "roleConditional": {
        "organizer": { "stroke": "#f59e0b" },
        "judge":     { "stroke": "#e2e8f0" },
        "volunteer": { "stroke": "#34d399" },
        "speaker":   { "stroke": "#fbbf24" }
      }
    },
    {
      "type": "photo",
      "id": "person-photo",
      "anchor": { "x": 16.5, "y": 16, "w": 21, "h": 21 },
      "binding": "{{person.photoUrl}}",
      "shape": "circle",
      "cornerRadius": 10.5,
      "fallback": "initials",
      "initialsBinding": "{{person.name}}",
      "initialsColor": "#ffffff",
      "initialsBg": "{{role.palette.primary}}"
    },
    {
      "type": "shape",
      "id": "info-zone-bg",
      "anchor": { "x": 0, "y": 47, "w": 54, "h": 38.6 },
      "shape": "rect",
      "fill": "#f8fafc",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "chevron-banner",
      "anchor": { "x": 0, "y": 41, "w": 54, "h": 9 },
      "shape": "polygon",
      "points": "0,9 27,0 54,9 54,9 0,9",
      "fill": "#f8fafc",
      "stroke": "transparent",
      "strokeWidth": 0,
      "cornerRadius": 0,
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "role-pill-bg",
      "anchor": { "x": 13, "y": 39, "w": 28, "h": 6 },
      "shape": "rect",
      "cornerRadius": 3,
      "fill": "#6d28d9",
      "fillBinding": "{{role.palette.primary}}",
      "stroke": "transparent",
      "strokeWidth": 0,
      "opacity": 1,
      "roleConditional": {
        "organizer": { "stroke": "#f59e0b" },
        "judge":     { "stroke": "#e2e8f0" }
      }
    },
    {
      "type": "text",
      "id": "role-label",
      "anchor": { "x": 13, "y": 39, "w": 28, "h": 6 },
      "content": "{{role.label}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 4.4,
      "fontWeight": "700",
      "color": "#ffffff",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 3,
      "roleConditional": {
        "organizer": { "color": "#f59e0b" }
      }
    },
    {
      "type": "text",
      "id": "person-name",
      "anchor": { "x": 2, "y": 47, "w": 50, "h": 7.2 },
      "content": "{{person.name}}",
      "fontFamily": "Space Grotesk",
      "fontSize": 8,
      "fontWeight": "700",
      "color": "#0f172a",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 5.2
    },
    {
      "type": "text",
      "id": "person-team",
      "anchor": { "x": 2, "y": 54.5, "w": 50, "h": 4 },
      "content": "{{person.team}}",
      "fontFamily": "Inter",
      "fontSize": 4,
      "fontWeight": "600",
      "color": "#334155",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2.8
    },
    {
      "type": "text",
      "id": "event-venue-date",
      "anchor": { "x": 2, "y": 59, "w": 50, "h": 3.5 },
      "content": "{{event.venue.value}} - {{event.dateStart.value}}",
      "fontFamily": "Inter",
      "fontSize": 3.2,
      "fontWeight": "400",
      "color": "#64748b",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 2.5
    },
    {
      "type": "qr",
      "id": "person-qr",
      "anchor": { "x": 23, "y": 63.5, "w": 8, "h": 8 },
      "urlPattern": "https://acm.svnit.ac.in/verify/{{person.id}}",
      "fgColor": "#160d38",
      "bgColor": "#f1f5f9",
      "errorCorrection": "M"
    },
    {
      "type": "barcode",
      "id": "person-barcode",
      "anchor": { "x": 7, "y": 73, "w": 40, "h": 8 },
      "valueBinding": "{{person.id}}",
      "format": "CODE128",
      "fgColor": "#0f172a",
      "bgColor": "#f8fafc"
    },
    {
      "type": "text",
      "id": "footer-validity",
      "anchor": { "x": 2, "y": 82.5, "w": 50, "h": 2.4 },
      "content": "VERIFIED CREDENTIAL - ACM SVNIT SURAT",
      "fontFamily": "Space Grotesk",
      "fontSize": 2.2,
      "fontWeight": "600",
      "color": "#94a3b8",
      "align": "center",
      "verticalAlign": "middle",
      "maxLines": 1,
      "minFontSize": 1.8
    }
  ]
}
